-  // The compare-exchange instruction uses registers as follows:
-  // old-value = EDX:EAX; new-value = ECX:EBX.
-  Register expected_hi = edx;
-  Register expected_lo = eax;
-  Register new_hi = ecx;
-  Register new_lo = ebx;
