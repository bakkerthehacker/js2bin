-void WasmGCTypeAnalyzer::ProcessAllocateStruct(
-    const WasmAllocateStructOp& allocate_struct) {
-  uint32_t type_index =
-      graph_.Get(allocate_struct.rtt()).Cast<RttCanonOp>().type_index;
