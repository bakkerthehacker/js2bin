-    StoreU64(scratch,
-             MemOperand(fp, (i - stack_param_delta) * kSystemPointerSize), r0);
-  }
-
-  // Set the new stack and frame pointer.
-  AddS64(sp, fp, Operand(-stack_param_delta * kSystemPointerSize), r0);
-  Pop(r0, fp);
-  mtlr(r0);
-}
