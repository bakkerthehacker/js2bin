-      }
-      case wasm::kRef:
-      case wasm::kRefNull:
-      case wasm::kI64:
-      case wasm::kRtt:
-      case wasm::kS128:
-      case wasm::kI8:
-      case wasm::kI16:
-      case wasm::kBottom:
-      case wasm::kVoid:
