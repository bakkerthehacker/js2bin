-      // Check overflow.
-      Ccmp(dst.gp().W(), -1, VFlag, ge);
-      B(trap, vs);
-      return true;
-    case kExprI32UConvertF32:
-      Fcvtzu(dst.gp().W(), src.fp().S());  // f32 -> i32 round to zero.
-      // Check underflow and NaN.
