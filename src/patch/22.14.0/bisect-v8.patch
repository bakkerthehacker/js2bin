-  if (is_float) {
-    switch (type.value()) {
-      case LoadType::kF32Load:
-        assm->emit_type_conversion(kExprF32ReinterpretI32, dst, tmp);
-        break;
-      case LoadType::kF64Load:
-        assm->emit_type_conversion(kExprF64ReinterpretI64, dst, tmp);
-        break;
-      default:
-        UNREACHABLE();
