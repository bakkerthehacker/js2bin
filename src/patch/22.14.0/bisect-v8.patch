-void LiftoffAssembler::IncrementSmi(LiftoffRegister dst, int offset) {
-  UseScratchRegisterScope temps(this);
-  if (COMPRESS_POINTERS_BOOL) {
-    DCHECK(SmiValuesAre31Bits());
