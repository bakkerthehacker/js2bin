-    case LoadType::kI32Load:
-    case LoadType::kI64Load32U:
-      Ldr(dst.gp().W(), src_op);
-      break;
-    case LoadType::kI64Load32S:
-      Ldrsw(dst.gp().X(), src_op);
-      break;
-    case LoadType::kI64Load:
-      Ldr(dst.gp().X(), src_op);
-      break;
-    case LoadType::kF32Load:
