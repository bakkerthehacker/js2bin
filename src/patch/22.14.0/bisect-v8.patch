-inline Condition cond_make_unsigned(Condition cond) {
-  switch (cond) {
-    case kLessThan:
-      return kUnsignedLessThan;
-    case kLessThanEqual:
-      return kUnsignedLessThanEqual;
-    case kGreaterThan:
-      return kUnsignedGreaterThan;
-    case kGreaterThanEqual:
-      return kUnsignedGreaterThanEqual;
-    default:
-      return cond;
-  }
