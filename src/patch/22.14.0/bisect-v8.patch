+void MemoryAllocator::Unmapper::CancelAndWaitForPendingTasks() {
+  if (job_handle_ && job_handle_->IsValid()) job_handle_->Join();
+
+  if (v8_flags.trace_unmapper) {
+    PrintIsolate(
+        heap_->isolate(),
