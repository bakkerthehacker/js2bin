-    names()->PrintElementSegmentName(out_, imm.index);
-    out_ << ",";
-  }
-
-  void I32Const(ImmI32Immediate& imm) {
-    if (imm.value >= 0 && imm.value <= 0x3F) {
-      out_ << "kExprI32Const, " << imm.value << ",";
