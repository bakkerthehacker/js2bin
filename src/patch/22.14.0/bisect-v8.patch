-inline void push(LiftoffAssembler* assm, LiftoffRegister reg, ValueKind kind,
-                 int padding = 0) {
-  switch (kind) {
-    case kI32:
-    case kI64:
-    case kRef:
-    case kRefNull:
-      assm->AllocateStackSpace(padding);
-      assm->pushq(reg.gp());
-      break;
-    case kF32:
-      assm->AllocateStackSpace(kSystemPointerSize + padding);
-      assm->Movss(Operand(rsp, 0), reg.fp());
-      break;
