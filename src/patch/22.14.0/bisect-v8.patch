-          __ Word32Add(__ Word32ShiftLeft(first_code_unit, 10),
-                       __ Word32Add(second_code_unit, surrogate_offset));
-      GOTO(done, value);
-
-      BIND(done, result);
-      return result;
-    }
-
-    UNREACHABLE();
