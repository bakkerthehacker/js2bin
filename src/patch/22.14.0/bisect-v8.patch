-constexpr int MaskFromNeonDataType(NeonDataType dt) {
-  switch (dt) {
-    case NeonS8:
-    case NeonU8:
-      return 7;
-    case NeonS16:
-    case NeonU16:
-      return 15;
-    case NeonS32:
-    case NeonU32:
-      return 31;
-    case NeonS64:
-    case NeonU64:
-      return 63;
-    default:
-      UNREACHABLE();
-      return 0;
-  }
-}
