-static FPUCondition ConditionToConditionCmpFPU(Condition condition) {
-  switch (condition) {
-    case kEqual:
-      return EQ;
-    case kNotEqual:
-      return NE;
-    case kUnsignedLessThan:
-      return LT;
-    case kUnsignedGreaterThanEqual:
-      return GE;
-    case kUnsignedLessThanEqual:
-      return LE;
-    case kUnsignedGreaterThan:
-      return GT;
-    default:
-      break;
-  }
-  UNREACHABLE();
-}
