-        case 2:
-          return static_cast<int16_t>(getPseudoRandom<uint16_t>());
-        case 4:
-          return static_cast<int32_t>(getPseudoRandom<uint32_t>());
-        default:
-          return static_cast<T>(
-              getPseudoRandom<std::make_unsigned_t<T>, max_bytes>());
-      }
-    }
