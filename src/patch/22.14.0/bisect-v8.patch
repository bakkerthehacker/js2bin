-      case HeapType::kStruct: {
-        constexpr HeapType::Representation generic_types[] = {
-            HeapType::kStruct,
-            HeapType::kNone,
-        };
-        const size_t type_count = structs_.size();
-        const size_t choice =
-            data->get<uint8_t>() % (type_count + arraysize(generic_types));
