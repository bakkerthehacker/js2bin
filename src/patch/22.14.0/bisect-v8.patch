-  switch (value.type().kind()) {
-    case kI32:
-      mov(src, Operand(value.to_i32()));
-      str(src, dst);
-      break;
-    case kI64: {
-      int32_t low_word = value.to_i64();
-      mov(src, Operand(low_word));
-      str(src, liftoff::GetHalfStackSlot(offset, kLowWord));
