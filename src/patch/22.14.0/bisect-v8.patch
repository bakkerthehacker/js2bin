-void LiftoffAssembler::Fill(LiftoffRegister reg, int offset, ValueKind kind) {
-  MemOperand src = liftoff::GetStackSlot(offset);
-  switch (kind) {
-    case kI32:
-      Lw(reg.gp(), src);
-      break;
-    case kI64:
-    case kRef:
-    case kRefNull:
-      Ld(reg.gp(), src);
-      break;
-    case kF32:
-      Lwc1(reg.fp(), src);
-      break;
-    case kF64:
-      MacroAssembler::Ldc1(reg.fp(), src);
-      break;
-    case kS128:
