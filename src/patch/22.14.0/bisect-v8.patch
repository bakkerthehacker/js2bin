-  OpIndex REDUCE(TransitionAndStoreArrayElement)(
-      V<JSArray> array, V<WordPtr> index, OpIndex value,
-      TransitionAndStoreArrayElementOp::Kind kind, MaybeHandle<Map> fast_map,
