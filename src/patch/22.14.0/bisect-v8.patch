+void LoopFinder::Run() {
+  ZoneVector<Block*> all_loops(phase_zone_);
+  for (Block& block : base::Reversed(input_graph_->blocks())) {
+    if (block.IsLoop()) {
+      LoopInfo info = VisitLoop(&block);
