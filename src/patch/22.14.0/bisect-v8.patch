diff --git a/deps/v8/.clang-format b/deps/v8/.clang-format
index 066c8d27c6..bd7d80dfb7 100644
--- a/deps/v8/.clang-format
+++ b/deps/v8/.clang-format
@@ -3,13 +3,4 @@
 BasedOnStyle: Google
 DerivePointerAlignment: false
 MaxEmptyLinesToKeep: 1
-IfMacros:
-  - IF
-  - IF_NOT
-Macros:
-  # Make clang-format think TurboShaft `ELSE` expands to just `else`, so that
-  # it formats well alongside `if`
-  - ELSE=else
-StatementMacros:
-  - DECL_CAST
-  - DECL_VERIFIER
+IfMacros: ['IF', 'IF_NOT', 'ELSE', 'ELSE_IF']
