-  DCHECK_NE(dst.low_gp(), kScratchReg);
-  DCHECK_NE(dst.high_gp(), kScratchReg);
-
-  MacroAssembler::ShlPair(dst.low_gp(), dst.high_gp(), src_low, src_high,
-                          amount & 63, kScratchReg, kScratchReg2);
