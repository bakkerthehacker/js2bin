-    }
-    case StoreType::kI32Store:
-    case StoreType::kI64Store32: {
-      __ cmpxchg(dst_op, scratch);
-      break;
-    }
-    default:
-      UNREACHABLE();
-  }
-  __ j(not_equal, &binop);
-
-  if (is_byte_store) {
-    __ pop(kRootRegister);
