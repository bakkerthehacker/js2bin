-bool LiftoffAssembler::emit_type_conversion(WasmOpcode opcode,
-                                            LiftoffRegister dst,
-                                            LiftoffRegister src, Label* trap) {
-  switch (opcode) {
-    case kExprI32ConvertI64:
-      Mov(dst.gp().W(), src.gp().W());
