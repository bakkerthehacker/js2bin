-    exit(-1);
-  }
-  builtins_edge_count = num_edges;
-  builtins_start = 1 + shmem->num_edges;
-  shmem->num_edges += builtins_edge_count;
-  printf("[COV] Additional %d edges for builtins initialized.\n", num_edges);
-}
