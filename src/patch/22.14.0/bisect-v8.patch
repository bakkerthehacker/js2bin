+enum NumericTypes { kIncludeNumericTypes, kExcludeNumericTypes };
+enum PackedTypes { kIncludePackedTypes, kExcludePackedTypes };
+enum Generics {
+  kAlwaysIncludeAllGenerics,
+  kExcludeSomeGenericsWhenTypeIsNonNullable
