-        asm_->AllocateStackSpace(stack_decrement - pushed_bytes);
-        switch (src.kind()) {
-          case kI64:
-          case kI32:
-          case kRef:
-          case kRefNull:
-          case kRtt:
-            asm_->push(src.reg().gp());
