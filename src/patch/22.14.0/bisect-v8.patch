-    Label loop;
-    bind(&loop);
-    str(r0, MemOperand(r1, /* offset */ kSystemPointerSize, PostIndex));
-    cmp(r1, r2);
-    b(&loop, ne);
-
-    pop(r2);
-    pop(r1);
-  }
-
-  pop(r0);
-}
