-#define EMIT_SET_CONDITION(dst, cond) \
-  {                                   \
-    Label done;                       \
-    lghi(dst, Operand(1));            \
-    b(cond, &done);                   \
-    lghi(dst, Operand(0));            \
-    bind(&done);                      \
-  }
