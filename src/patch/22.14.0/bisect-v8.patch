-    return Op(input);
-        UNOP_LIST(CASE)
-#undef CASE
-      }
-    }
-
-    OpIndex Emit(TSBinop op, OpIndex left, OpIndex right) {
-      switch (op) {
-#define CASE(Op)       \
-  case TSBinop::k##Op: \
-    return Op(left, right);
-        BINOP_LIST(CASE)
-#undef CASE
-      }
-    }
