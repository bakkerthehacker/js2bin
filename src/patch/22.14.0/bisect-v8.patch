-      is_signed && div_or_rem == DivOrRem::kDiv;
-  constexpr bool special_case_minus_1 =
-      is_signed && div_or_rem == DivOrRem::kRem;
-  DCHECK_EQ(needs_unrepresentable_check, trap_div_unrepresentable != nullptr);
