-void LiftoffAssembler::emit_cond_jump(Condition cond, Label* label,
-                                      ValueKind kind, Register lhs,
-                                      Register rhs,
-                                      const FreezeCacheState& frozen) {
-  bool use_signed = is_signed(cond);
-
-  if (rhs != no_reg) {
-    switch (kind) {
-      case kI32:
-        if (use_signed) {
-          CmpS32(lhs, rhs);
-        } else {
-          CmpU32(lhs, rhs);
-        }
-        break;
-      case kRef:
-      case kRefNull:
-      case kRtt:
-        DCHECK(cond == kEqual || cond == kNotEqual);
-#if defined(V8_COMPRESS_POINTERS)
-        if (use_signed) {
-          CmpS32(lhs, rhs);
-        } else {
-          CmpU32(lhs, rhs);
-        }
-#else
-        if (use_signed) {
-          CmpS64(lhs, rhs);
-        } else {
-          CmpU64(lhs, rhs);
-        }
-#endif
-        break;
-      case kI64:
-        if (use_signed) {
-          CmpS64(lhs, rhs);
-        } else {
-          CmpU64(lhs, rhs);
-        }
-        break;
-      default:
-        UNREACHABLE();
-    }
-  } else {
-    DCHECK_EQ(kind, kI32);
-    CHECK(use_signed);
-    CmpS32(lhs, Operand::Zero(), r0);
-  }
-
-  b(to_condition(cond), label);
-}
