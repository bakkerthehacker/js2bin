-                                 : get<uint8_t>();
-    uint16_t num_bytes = random_choice % std::max(size_t{1}, data_.size());
-    int64_t new_seed = rng_.initial_seed() ^ rng_.NextInt64();
-    DataRange split(data_.SubVector(0, num_bytes), new_seed);
