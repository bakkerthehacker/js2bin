-              ? CallBuiltin<WasmTaggedNonSmiToInt32Descriptor>(
-                    Builtin::kWasmTaggedNonSmiToInt32, frame_state.value(),
-                    Operator::kNoProperties, value, context)
-              : CallBuiltin<WasmTaggedNonSmiToInt32Descriptor>(
-                    Builtin::kWasmTaggedNonSmiToInt32, Operator::kNoProperties,
-                    value, context);
