-  }
-  for (uint32_t i = 0; i < cov_map.size(); ++i) {
-    if (cov_map[i]) {
-      const uint32_t byteIndex = (i + builtins_start) >> 3;
-      const uint32_t bitIndex = (i + builtins_start) & 7;
-
-      shmem->edges[byteIndex] |= (1 << bitIndex);
-    }
-  }
-}
