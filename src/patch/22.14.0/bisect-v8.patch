-  Register offset = r1;
-  Register result_low = r4;
-  Register result_high = r5;
-  Register new_value_low = r2;
-  Register new_value_high = r3;
-  Register store_result = r6;
-  Register expected_low = r8;
-  Register expected_high = r9;
