+  auto call_descriptor = Linkage::ComputeIncoming(&zone, &info);
+  Handle<Code> code =
+      Pipeline::GenerateCodeForTesting(&info, isolate, call_descriptor, graph,
+                                       AssemblerOptions::Default(isolate))
+          .ToHandleChecked();
+  function->set_code(*code, kReleaseStore);
+  return function;
+}
