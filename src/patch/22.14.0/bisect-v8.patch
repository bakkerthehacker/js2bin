-        any_block(base::VectorOf(param_types), types, data);
-        return;
-      }
-    }
-
-    if (types.size() == 0) {
-      Generate(kWasmVoid, data);
-      return;
-    }
-    if (types.size() == 1) {
-      Generate(types[0], data);
-      return;
-    }
