-#define EMIT_EQZ(test, src) \
-  {                         \
-    Label done;             \
-    test(r0, src);          \
-    mov(dst, Operand(1));   \
-    beq(&done);             \
-    mov(dst, Operand(0));   \
-    bind(&done);            \
-  }
