-  std::array<T, kSumOfLengths> result = {0};
-  size_t result_index = 0;
-  for (size_t arr = 0; arr < kNumArrays; arr++) {
-    for (size_t pos = 0; pos < kLengths[arr]; pos++) {
-      result[result_index++] = kArrays[arr][pos];
-    }
-  }
-  return result;
