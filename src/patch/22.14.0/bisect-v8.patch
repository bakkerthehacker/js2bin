+                        ? graph_zone_->New<NodeOriginTable>(graph_)
+                        : nullptr;
+    simplified_ = graph_zone_->New<SimplifiedOperatorBuilder>(graph_zone_);
+    machine_ = graph_zone_->New<MachineOperatorBuilder>(
