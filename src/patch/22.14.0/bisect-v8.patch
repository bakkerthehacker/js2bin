-void LiftoffAssembler::emit_i64_muli(LiftoffRegister dst, LiftoffRegister lhs,
-                                     int32_t imm) {
-  if (base::bits::IsPowerOfTwo(imm)) {
-    emit_i64_shli(dst, lhs, base::bits::WhichPowerOfTwo(imm));
-    return;
-  }
-  mov(r0, Operand(imm));
-  MulS64(dst.gp(), lhs.gp(), r0);
-}
