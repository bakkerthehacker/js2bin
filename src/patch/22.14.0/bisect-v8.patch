-int LiftoffAssembler::PrepareStackFrame() {
-  int offset = pc_offset();
-  // When the frame size is bigger than 4KB, we need seven instructions for
-  // stack checking, so we reserve space for this case.
-  daddiu(sp, sp, 0);
-  nop();
-  nop();
-  nop();
-  nop();
-  nop();
-  nop();
-  return offset;
-}
